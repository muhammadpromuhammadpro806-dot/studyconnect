name: Build signed release AAB
on:
  workflow_dispatch:
    inputs:
      real_ads:
        description: "Use REAL ads? (false = test ads, for closed testing)"
        type: choice
        options: ["false", "true"]
        default: "false"
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21
      - run: npm install
      - run: mkdir -p www && cp index.html www/index.html
      - name: Choose test or real ads
        run: |
          if [ "${{ inputs.real_ads }}" != "true" ]; then
            sed -i 's/const ADS={test:false/const ADS={test:true/' www/index.html
          fi
      - run: npx cap add android
      - name: Add AdMob app ID
        run: |
          ID="ca-app-pub-2701121470969867~7752984934"
          sed -i "s#</application>#<meta-data android:name=\"com.google.android.gms.ads.APPLICATION_ID\" android:value=\"$ID\"/></application>#" android/app/src/main/AndroidManifest.xml
      - run: npx cap sync android
      - name: Set version number
        run: sed -i -E "s/versionCode[ =]+[0-9]+/versionCode ${{ github.run_number }}/" android/app/build.gradle
      - name: Build bundle
        working-directory: android
        run: ./gradlew bundleRelease
      - name: Sign bundle
        env:
          KS_B64: ${{ secrets.KEYSTORE_BASE64 }}
          KS_PASS: ${{ secrets.KEYSTORE_PASSWORD }}
        run: |
          echo "$KS_B64" | base64 -d > upload.jks
          jarsigner -sigalg SHA256withRSA -digestalg SHA-256 -keystore upload.jks -storepass "$KS_PASS" android/app/build/outputs/bundle/release/app-release.aab upload
          rm -f upload.jks
      - uses: actions/upload-artifact@v4
        with:
          name: studyconnect-release-aab
          path: android/app/build/outputs/bundle/release/app-release.aab
